    "http-cache-semantics": "^4.3.0",
    "braces": "^3.0.3",
    "decode-uri-component": "^0.4.1",
    "unset-value": "^2.0.1",
    "cross-spawn": "$cross-spawn",
    "decompress": "npm:@xhmikosr/decompress@^11.1.4",
    "fast-xml-parser": "^5.7.0",
    "semver-regex": "^4.0.5",
    "glob": {
      "minimatch": "^11.0.2"
    },
    "minimatch": "^11.0.4",
    "xml-crypto": "^6.4.0",
    "moment": "$moment",
    "glob-parent": "^5.1.2",
    "micromatch": "^4.0.8",
    "file-type": "^16.5.4",
    "tough-cookie": "^4.1.4",
    "xml2js": "^0.6.2",
    "fast-uri": "^3.0.6",
    "brace-expansion": "^2.0.1",
    "ajv": "^8.17.1",
    "immutable": "^5.1.9",
    "picomatch": "^2.3.1",
    "nanoid": "^3.3.11",
    "postcss": "^8.5.6",
    "diff": "^5.2.2",
    "rollup": "^4.67.5",
    "uuid": "$uuid",
    "ioredis": "$ioredis",
    "got": "$got",
    "eslint-config-habitrpg": {
      "eslint": "$eslint"
